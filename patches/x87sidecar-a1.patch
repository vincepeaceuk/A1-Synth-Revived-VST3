@@ -1529,19 +1531,58 @@ int main(int argc, char* argv[]) try {
             return 1;
         }
         VERBOSE_LOG("[rosettax87] cooperative service registered: %s\n", coopName.c_str());
+        // Watch the owned target before releasing it, including early close
+        // while its constructor has not yet sent the cooperative handshake.
+        int startupWatch = kqueue();
+        struct kevent watch;
+        EV_SET(&watch, parentPid, EVFILT_PROC, EV_ADD | EV_ONESHOT, NOTE_EXIT, 0, nullptr);
+        if (startupWatch < 0 || kevent(startupWatch, &watch, 1, nullptr, 0, nullptr) < 0) {
+            if (startupWatch >= 0) close(startupWatch);
+            return 1;
+        }
         write(syncPipe[1], "x", 1);
         close(syncPipe[1]);
         unhookedNotice.prog = progArgv[0];  // the target is launched from here on
         unhookedNotice.pid = parentPid;
 
         x87_coop_request_rcv_t rcv{};
-        kr = mach_msg(&rcv.req.header, MACH_RCV_MSG | MACH_RCV_TIMEOUT, 0, sizeof(rcv), servicePort,
-                      30000, MACH_PORT_NULL);
+        for (unsigned elapsed = 0; elapsed < 30000; elapsed += 100) {
+            kr = mach_msg(&rcv.req.header, MACH_RCV_MSG | MACH_RCV_TIMEOUT, 0, sizeof(rcv), servicePort,
+                          100, MACH_PORT_NULL);
+            if (kr != MACH_RCV_TIMED_OUT) break;
+            struct kevent exited;
+            struct timespec immediate = {0, 0};
+            if (kevent(startupWatch, nullptr, 0, &exited, 1, &immediate) != 0) break;
+        }
+        close(startupWatch);
         if (kr != KERN_SUCCESS) {
             fprintf(stdout, "[rosettax87] cooperative handshake receive failed: 0x%x (%s)\n", kr,
                     mach_error_string(kr));
             return 1;
         }
+        // This service is for exactly the original target, never another task.
+        pid_t senderPid = 0;
+        if (rcv.req.header.msgh_id != X87_COOP_MSGH_ID ||
+            rcv.req.header.msgh_size != sizeof(x87_coop_request_t) ||
+            !(rcv.req.header.msgh_bits & MACH_MSGH_BITS_COMPLEX) ||
+            rcv.req.body.msgh_descriptor_count != 2 ||
+            rcv.req.task_port.type != MACH_MSG_PORT_DESCRIPTOR ||
+            rcv.req.thread_port.type != MACH_MSG_PORT_DESCRIPTOR ||
+            pid_for_task(rcv.req.task_port.name, &senderPid) != KERN_SUCCESS || senderPid != parentPid) {
+            mach_msg_destroy(&rcv.req.header);
+            return 1;
+        }
+        thread_act_array_t threads = nullptr;
+        mach_msg_type_number_t count = 0;
+        bool ownsThread = false;
+        if (task_threads(rcv.req.task_port.name, &threads, &count) == KERN_SUCCESS) {
+            for (unsigned i = 0; i < count; ++i) {
+                ownsThread |= threads[i] == rcv.req.thread_port.name;
+                mach_port_deallocate(mach_task_self(), threads[i]);
+            }
+            vm_deallocate(mach_task_self(), reinterpret_cast<vm_address_t>(threads), count * sizeof(thread_t));
+        }
+        if (!ownsThread) { mach_msg_destroy(&rcv.req.header); return 1; }
         unhookedNotice.handshook = true;
         task_t traceeTask = rcv.req.task_port.name;
         thread_t traceeThread = rcv.req.thread_port.name;
